---
/** Einfache Strich-Icons (24×24), Farbe folgt dem Text. */
interface Props {
  name: string;
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'metronome' && (
      <>
        <path d="M9.5 3h5l4.5 18H5L9.5 3z" />
        <path d="M7 16h10" />
        <path d="M12 16l5.5-9" />
      </>
    )
  }
  {
    name === 'tuner' && (
      <>
        <path d="M3.5 17a8.5 8.5 0 0 1 17 0" />
        <path d="M12 17l3.5-6" />
        <path d="M12 6.5V8M5.6 9.6l1 1M18.4 9.6l-1 1" />
        <circle cx="12" cy="17" r="1.2" fill="currentColor" />
      </>
    )
  }
  {
    name === 'finder' && (
      <>
        <path d="M9 18V5.5l10-2V16" />
        <circle cx="6.5" cy="18" r="2.5" />
        <circle cx="16.5" cy="16" r="2.5" />
      </>
    )
  }
  {
    name === 'scales' && (
      <>
        <rect x="2.5" y="6" width="19" height="12" rx="2" />
        <path d="M8.5 6v12M14.5 6v12" />
        <circle cx="5.5" cy="10" r="1.3" fill="currentColor" />
        <circle cx="11.5" cy="14" r="1.3" fill="currentColor" />
        <circle cx="18" cy="10" r="1.3" fill="currentColor" />
      </>
    )
  }
  {
    name === 'chords' && (
      <>
        <path d="M5.5 4h13" stroke-width="2.6" />
        <path d="M5.5 4v16M10 4v16M14 4v16M18.5 4v16M5.5 10h13M5.5 15h13" stroke-width="1.3" />
        <circle cx="10" cy="7" r="1.9" fill="currentColor" stroke="none" />
        <circle cx="14" cy="12.5" r="1.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'settings' && (
      <>
        <path d="M4 7h9M17 7h3M4 17h3M11 17h9" />
        <circle cx="15" cy="7" r="2" />
        <circle cx="9" cy="17" r="2" />
      </>
    )
  }
</svg>
