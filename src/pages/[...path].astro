---
import AppLayout from '../layouts/AppLayout.astro';
import NoteFinder from '../components/NoteFinder.svelte';
import Metronome from '../components/Metronome.svelte';
import ScaleMap from '../components/ScaleMap.svelte';
import ChordChart from '../components/ChordChart.svelte';
import Tuner from '../components/Tuner.svelte';
import AudioSettings from '../components/AudioSettings.svelte';
import { languages, slugs, toolPath, tools, toolHref, ui, type Lang, type Tool } from '../i18n/ui';

export function getStaticPaths() {
  const langs = Object.keys(languages) as Lang[];
  const pages = langs.flatMap((lang) =>
    tools.map((tool) => ({ params: { path: toolPath(lang, tool) || undefined }, props: { lang, tool, redirect: false } })),
  );
  // Frühere Adressen /de/… leiten auf die neuen ohne Sprachkürzel weiter (geteilte Links bleiben gültig)
  const legacy = tools.map((tool) => ({
    params: { path: ['de', slugs.de[tool]].filter(Boolean).join('/') },
    props: { lang: 'de' as Lang, tool, redirect: true },
  }));
  return [...pages, ...legacy];
}

const { lang, tool, redirect } = Astro.props as { lang: Lang; tool: Tool; redirect: boolean };
const t = ui[lang];
const langs = Object.keys(languages) as Lang[];
const themes = [
  ['system', t.prefs.auto],
  ['light', t.prefs.light],
  ['dark', t.prefs.dark],
] as const;
---

{
  redirect && (
    <html lang="de">
      <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex" />
        <link rel="canonical" href={new URL(toolHref(lang, tool), Astro.site)} />
        <meta http-equiv="refresh" content={`0; url=${toolHref(lang, tool)}`} />
        <script is:inline define:vars={{ target: toolHref(lang, tool) }}>location.replace(target + location.search + location.hash);</script>
        <title>Guitar Tools</title>
      </head>
      <body><a href={toolHref(lang, tool)}>Guitar Tools</a></body>
    </html>
  )
}
{!redirect && (
<AppLayout lang={lang} tool={tool}>
  {
    tool === 'finder' && (
      <section>
        <h1>{t.finder.title}</h1>
        <p class="sub">{t.finder.sub}</p>
        <NoteFinder client:load t={t.finder} mic={t.mic} lang={lang} settingsHref={`${toolHref(lang, 'settings')}#audio`} />
      </section>
    )
  }
  {
    tool === 'metronome' && (
      <section>
        <h1>{t.metronome.title}</h1>
        <p class="sub">{t.metronome.sub}</p>
        <Metronome client:load t={t.metronome} />
      </section>
    )
  }
  {
    tool === 'tuner' && (
      <section>
        <h1>{t.tuner.title}</h1>
        <p class="sub">{t.tuner.sub}</p>
        <Tuner client:load t={t.tuner} mic={t.mic} lang={lang} settingsHref={`${toolHref(lang, 'settings')}#audio`} />
      </section>
    )
  }
  {
    tool === 'scales' && (
      <section>
        <h1>{t.scales.title}</h1>
        <p class="sub">{t.scales.sub}</p>
        <ScaleMap client:load t={t.scales} lang={lang} />
      </section>
    )
  }
  {
    tool === 'chords' && (
      <section>
        <h1>{t.chords.title}</h1>
        <p class="sub">{t.chords.sub}</p>
        <ChordChart client:load t={t.chords} lang={lang} />
      </section>
    )
  }
  {
    tool === 'settings' && (
      <section class="settings">
        <h1>{t.prefs.title}</h1>
        <p class="sub">{t.prefs.sub}</p>
        <div class="card">
          <div class="field">
            <div>
              <span>{t.prefs.theme}</span>
              <p class="note-small">{t.prefs.themeHint}</p>
            </div>
            <div class="seg" data-theme-switch role="radiogroup" aria-label={t.prefs.theme}>
              {themes.map(([v, l]) => (
                <button type="button" role="radio" data-v={v} class={v === 'system' ? 'active' : ''}>
                  {l}
                </button>
              ))}
            </div>
          </div>
          <div class="field">
            <span>{t.prefs.lang}</span>
            <div class="seg">
              {langs.map((l) => (
                <a href={toolHref(l, 'settings')} hreflang={l} lang={l} data-lang-choice={l} class={l === lang ? 'active' : ''}>
                  {languages[l]}
                </a>
              ))}
            </div>
          </div>
        </div>
        <div class="card" id="audio" style="margin-top:16px">
          <div class="label">{t.mic.section}</div>
          <p class="note-small" style="margin:0 0 6px">{t.mic.sectionHint}</p>
          <AudioSettings client:load t={t.mic} lang={lang} />
        </div>
        <div class="card" style="margin-top:16px">
          <div class="label">{t.prefs.install}</div>
          <p class="note-small" style="margin:0">{t.prefs.installHint}</p>
          <div class="label" style="margin-top:20px">{t.prefs.about}</div>
          <p class="note-small" style="margin:0">
            {t.prefs.aboutText} <a href="https://github.com/cesure/guitar-tools">github.com/cesure/guitar-tools</a>
          </p>
        </div>
      </section>
    )
  }
</AppLayout>
)}

<style>
  .settings { max-width: 640px; }
  .note-small { color: var(--muted); font-size: 13px; margin: 2px 0 0; }
  .settings .field { flex-wrap: wrap; padding: 14px 0; }
</style>
