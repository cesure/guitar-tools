---
import '../styles/global.css';
import { pwaInfo } from 'virtual:pwa-info';
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/Icon.astro';
import MiniMetronome from '../components/MiniMetronome.svelte';
import { defaultLang, languages, navGroups, toolHref, ui, type Lang, type Tool } from '../i18n/ui';

interface Props {
  lang: Lang;
  tool: Tool;
}
const { lang, tool } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const langs = Object.keys(languages) as Lang[];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.nav[tool]} · Guitar Tools</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <meta name="theme-color" content="#f4f2ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(toolHref(l, tool), Astro.site)} />)}
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <!-- Seitenwechsel ohne Neuladen: das Metronom läuft weiter, während man Skalen oder Akkorde ansieht -->
    <ClientRouter fallback="swap" />
    {
      lang === defaultLang && tool === 'metronome' && (
        <script is:inline define:vars={{ enHref: toolHref('en', 'metronome') }}>
          // Startseite: wer Englisch gewählt hat oder einen englischen Browser nutzt, landet auf /en/
          try {
            var chosen = localStorage.getItem('gt-lang');
            var browser = ((navigator.languages || [navigator.language])[0] || '').slice(0, 2);
            if (chosen === 'en' || (!chosen && browser && browser !== 'de')) location.replace(enHref + location.search);
          } catch (e) {}
        </script>
      )
    }
    <script is:inline>
      try {
        var saved = localStorage.getItem('gt-theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <aside class="sidebar">
      <a class="brand" href={toolHref(lang, 'metronome')}><img src={`${base}favicon.svg`} alt="" /> Guitar Tools</a>
      {
        navGroups.map((g) => (
          <nav aria-label={t.nav[g.id]}>
            <div class="nav-group">{t.nav[g.id]}</div>
            {g.tools.map((id) => (
              <a href={toolHref(lang, id)} aria-current={id === tool ? 'page' : undefined}>
                <span class="ic"><Icon name={id} /></span> {t.nav[id]}
              </a>
            ))}
          </nav>
        ))
      }
      <nav class="nav-bottom" aria-label={t.nav.settings}>
        <a href={toolHref(lang, 'settings')} aria-current={tool === 'settings' ? 'page' : undefined}>
          <span class="ic"><Icon name="settings" /></span> {t.nav.settings}
        </a>
      </nav>
    </aside>

    <header class="mobile-top">
      <a class="brand" href={toolHref(lang, 'metronome')}><img src={`${base}favicon.svg`} alt="" /> <span>Guitar Tools</span></a>
      <a class="gear" href={toolHref(lang, 'settings')} aria-label={t.nav.settings} aria-current={tool === 'settings' ? 'page' : undefined}><Icon name="settings" size={22} /></a>
    </header>

    <main>
      <slot />
    </main>

    {tool !== 'metronome' && <MiniMetronome client:load transition:persist="mini-metronome" t={t.metronome} href={toolHref(lang, 'metronome')} />}

    <nav class="tabbar" aria-label="Guitar Tools">
      {
        navGroups.map((g, gi) =>
          g.tools.map((id, i) => (
            <a href={toolHref(lang, id)} aria-current={id === tool ? 'page' : undefined} class={gi > 0 && i === 0 ? 'group-start' : ''}>
              <span class="ic"><Icon name={id} /></span>
              {t.navShort[id]}
            </a>
          )),
        )
      }
    </nav>

    <script>
      import { registerSW } from 'virtual:pwa-register';

      // Darstellung: Automatisch / Hell / Dunkel (Knöpfe auf der Einstellungsseite)
      const root = document.documentElement;
      let current = root.dataset.theme || 'system';
      const BAR = { light: '#f4f2ee', dark: '#121214' } as const;
      /** Theme aufs <html> setzen und die Farbe der Handy-Statusleiste anpassen */
      const apply = () => {
        if (current === 'system') delete root.dataset.theme;
        else root.dataset.theme = current;
        document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => {
          const auto = m.media.includes('dark') ? BAR.dark : BAR.light;
          m.content = current === 'light' || current === 'dark' ? BAR[current] : auto;
        });
      };
      const render = () =>
        document.querySelectorAll<HTMLButtonElement>('[data-theme-switch] button').forEach((b) => {
          b.classList.toggle('active', b.dataset.v === current);
          b.setAttribute('aria-checked', String(b.dataset.v === current));
        });
      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-theme-switch] button');
        if (!b) return;
        current = b.dataset.v ?? 'system';
        apply();
        try {
          if (current === 'system') localStorage.removeItem('gt-theme');
          else localStorage.setItem('gt-theme', current);
        } catch {
          /* ohne Speichern weiter */
        }
        render();
      });
      apply();
      render();
      // Nach einem Seitenwechsel ohne Neuladen: <html> und <head> kommen frisch vom Server → Theme erneut setzen
      document.addEventListener('astro:after-swap', apply);
      document.addEventListener('astro:page-load', render);

      // Sprache nur merken, wenn sie bewusst gewählt wird
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lang-choice]');
        if (!a) return;
        try {
          localStorage.setItem('gt-lang', a.dataset.langChoice ?? '');
        } catch {
          /* ohne Speichern weiter */
        }
      });

      // Offline-Modus (PWA)
      registerSW({ immediate: true });
    </script>
  </body>
</html>
