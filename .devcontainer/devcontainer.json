{
  "name": "guitar-tools",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": { "label": "Astro Dev-Server", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm ci",
  "containerEnv": { "GT_POLL": "1", "ASTRO_TELEMETRY_DISABLED": "1" },
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "svelte.svelte-vscode"
      ]
    }
  }
}
